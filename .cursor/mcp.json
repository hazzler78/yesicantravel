{
  "mcpServers": {
    "search-console": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "search-console-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/.cursor/secrets/gsc-service-account.json"
      }
    },
    "mailerlite-yict": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.mailerlite.com/mcp?account=yict",
        "8791"
      ]
    }
  }
}
